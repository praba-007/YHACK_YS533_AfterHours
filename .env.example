# MACH PULSE - Environment Configuration Template
# Copy this file to .env for local environment overrides (git-ignored)

# --------------------------------------------------------------------------- #
# Backend API & Server Configuration
# --------------------------------------------------------------------------- #
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=

# --------------------------------------------------------------------------- #
# Frontend Configuration (Netlify / Local)
# --------------------------------------------------------------------------- #
# Local development: http://localhost:8000/api
# Production deployment: https://<your-render-app>.onrender.com/api
VITE_API_BASE_URL=http://localhost:8000/api

# --------------------------------------------------------------------------- #
# AI Explanation & Chat Layer (Optional, Backend)
# --------------------------------------------------------------------------- #
# Provider options: "gemini" | "claude" | "local" | "none" (default)
MACHPULSE_LLM_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=
MACHPULSE_LLM_MODEL=gemini-2.5-flash

# Anthropic Claude API Key
ANTHROPIC_API_KEY=

# LLM Call Limits
MACHPULSE_LLM_TIMEOUT_SECONDS=20
MACHPULSE_LLM_MAX_TOKENS=1024
