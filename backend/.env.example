# MachPulse Backend - Environment Configuration
#
# Copy to backend/.env (git-ignored) for local overrides. Every value below is
# OPTIONAL: with no provider configured the AI endpoints serve a deterministic
# explanation and all other endpoints are unaffected. Never commit a real key.

# --------------------------------------------------------------------------- #
# Server & CORS Configuration (Deployment / Render)
# --------------------------------------------------------------------------- #
PORT=8000
ENVIRONMENT=development

# Comma-separated allowed origins (Netlify *.netlify.app allowed automatically)
# Example: CORS_ORIGINS=https://machpulse.netlify.app,https://mycustomdomain.com
CORS_ORIGINS=

# --------------------------------------------------------------------------- #
# AI Provider (Phase 4 /api/ai/explain, Phase 5A /api/ai/chat)
# --------------------------------------------------------------------------- #

# Which provider phrases the AI output: "gemini" | "claude" | "local" | "none" (default)
MACHPULSE_LLM_PROVIDER=gemini

# Gemini provider (Google)
GEMINI_API_KEY=
MACHPULSE_LLM_MODEL=gemini-2.5-flash

# Claude provider (Anthropic)
ANTHROPIC_API_KEY=

# Shared call limits
MACHPULSE_LLM_TIMEOUT_SECONDS=20
MACHPULSE_LLM_MAX_TOKENS=1024

# Future on-premise model for "local" provider (OpenAI-compatible base URL)
MACHPULSE_LOCAL_LLM_BASE_URL=
MACHPULSE_LOCAL_LLM_MODEL=local-model
MACHPULSE_LOCAL_LLM_API_KEY=
